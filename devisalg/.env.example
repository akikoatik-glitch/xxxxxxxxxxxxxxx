# ============================================================
# DevisAlg — Server environment variables
# Copy this file to `.env` and fill in production secrets.
# NEVER commit `.env`.
# ============================================================

# HTTP port
PORT=4000

# Secret used to sign auth sessions (set a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Set to 'true' when serving over HTTPS (cookies get Secure flag)
COOKIE_SECURE=false

# ------------------------------------------------------------------
# WhatsApp Business Cloud API (Official Meta API).
# These are read server-side by the techie integration. The in-app
# WhatsApp setup screen stores per-business credentials in the DB
# (also server-side). Leave empty to rely only on the in-app setup.
# ------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ------------------------------------------------------------------
# Optional LLM provider (OpenAI-compatible chat completions).
# When set, the AI engine uses this model for richer replies while
# still injecting the business's REAL catalog and strict no-invent
# rules. When empty, the deterministic Darija/French engine is used.
# ------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Reminder scan interval in ms (default 1 hour)
REMINDER_INTERVAL_MS=3600000
