# ──────────────────────────────────────────────────────────────
# XWhiz Lite — Environment Variables
# Copy to .env.local and fill in. The app runs in demo mode
# with mock data when API keys are not provided.
# ──────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Prisma — Supabase Postgres connection string
# Dashboard > Project Settings > Database > Connection string (pooler)
DATABASE_URL=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM="XWhiz Lite <onboarding@resend.dev>"

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# API-Football via RapidAPI (optional — live data feed)
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# OpenWeatherMap (optional — weather impact widget)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
