# ─────────────────────────────────────────────────────────────
#  Assist. — Environment configuration
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the real `.env` (it holds secrets).
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:4000

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Database
# Path to the SQLite database file (relative to the project root)
DB_PATH=./data/assist.db

# ─────────────────────────────────────────────────────────────
#  AI providers — FREE options (no credit card). Set ONE of these
#  and the agent becomes fully conversational on every message.
#  Leave all empty to use the built-in rule engine (works, but
#  only understands ordering/price/FAQ — not free conversation).
# ─────────────────────────────────────────────────────────────

# OPTION A — Groq (fastest, free, no card): https://console.groq.com → API Keys
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OPTION B — Google Gemini (free, no card): https://ai.google.dev → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OPTION C — OpenRouter (free models, no card): https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Paid alternatives (optional, if you already have keys)
# LLM_PROVIDER can also be: none | auto | openai | anthropic | gemini | groq | openrouter | local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local (any OpenAI-compatible endpoint, e.g. Ollama at http://localhost:11434/v1)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=llama3.1

# ─────────────────────────────────────────────────────────────
#  Messaging platform integrations
#  Each platform is configured securely in the dashboard.
#  OAuth / API tokens / webhooks never ship in frontend code.
# ─────────────────────────────────────────────────────────────

# WhatsApp
# Cloud API: token with WhatsApp.Business.Messaging scope
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Telegram (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Facebook Messenger (page access token)
FB_PAGE_TOKEN=
FB_VERIFY_TOKEN=

# Instagram (long-lived user/page token)
IG_TOKEN=
IG_VERIFY_TOKEN=

# Base URL of this server (used to build webhook callback URLs and PDF links)
PUBLIC_BASE_URL=http://localhost:4000
